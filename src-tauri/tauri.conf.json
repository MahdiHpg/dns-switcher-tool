{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DNS Switcher",
  "version": "1.2.0",
  "identifier": "ir.mahdi-hp.dns-switcher",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "startMenuFolder": "DNS Switcher"
      }
    }
  }
}
